{
  "name": "EVPulse India Executive Light",
  "dataColors": [
    "#0D9488",
    "#2563EB",
    "#F59E0B",
    "#10B981",
    "#6366F1",
    "#0284C7",
    "#8B5CF6",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0D9488",
  "visualStyles": {
    "*": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#F8FAFC" } } }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#000000" } }, "transparency": 95, "position": "Outer", "preset": "BottomRight" }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0F172A" } }, "fontSize": 24, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#64748B" } }, "fontSize": 10, "fontFamily": "Segoe UI" }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1E293B" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }],
        "items": [{ "fontColor": { "solid": { "color": "#334155" } }, "fontSize": 9, "fontFamily": "Segoe UI" }]
      }
    }
  }
}
